# P0 驗證用的暫存建置產物與大型測試模型，不進 git
progress/p0/build/
progress/p0/venv-arm64/
progress/p0/*.log

# P1 ASR 選型測試用的音檔（可重新產生，不用進 git）
progress/p1_asr_bench/wav_raw/
progress/p1_asr_bench/wav_16k/
progress/p1_asr_bench/*_debug.txt
progress/p1_asr_bench/*_stdout.txt

# 主控台執行時期產生的狀態檔，不用進 git
console/live_state.json
console/wake_word_setting.json

# 語音測試用的合成/錄音音檔跟暫存結果（可重新產生，不用進 git）
src/*.wav
src/*_result.txt
src/*_result.json
src/mic_check.txt
progress/p1_wakeword_train/positive/
progress/p1_wakeword_train/negative/
